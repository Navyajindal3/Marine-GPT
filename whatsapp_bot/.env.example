# --- Twilio console (https://console.twilio.com) ---
# Account SID + Auth Token are on the Console Dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# The free WhatsApp Sandbox number from:
#   Messaging -> Try It Out -> Send a WhatsApp message
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Your sandbox join code (fisherman's phone sends: join <CODE> to the number above)
TWILIO_SANDBOX_JOIN_CODE=join gravel-....

# Twilio sandbox approved content id (needed for outbound on trial accounts);
# find it in Twilio: Messaging -> Try It Out -> Send a WhatsApp message (content/template box)
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxx

# Local server port
PORT=5000

# --- Optional extras ---
# Persist conversations to a JSON file so chats survive a restart.
# KOCHI_SESSIONS_PATH=sessions.json
# Verify inbound X-Twilio-Signature (set 1 when going live behind ngrok).
# TWILIO_VERIFY_SIGNATURE=1
# Return JSON instead of TwiML (handy for curl/testing).
# KOCHI_FORCE_JSON=0

# ============================================================================
# Meta WhatsApp Cloud API - THE FREE, OFFICIAL, CONVERSATIONAL path
# (no template restriction for user-initiated replies; 1000 conversations/mo free.
# Get these from https://developers.facebook.com (create app -> add WhatsApp):
#   WHATSAPP_TOKEN         = temporary access token (WhatsApp -> API Setup page)
#   WHATSAPP_PHONE_NUMBER_ID = 15-digit id of the bot's number (same page, "From")
#   WHATSAPP_VERIFY_TOKEN  = any secret string YOU choose (reuse it when registering
#                            the webhook callback in Meta's dashboard for verification)
# Older META_* names (META_ACCESS_TOKEN / META_PHONE_NUMBER_ID /
# META_VERIFY_TOKEN) are accepted as aliases too.
# ============================================================================
WHATSAPP_TOKEN=EAAG_your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=kochi-marine-2026

# ============================================================================
# GREEN-API (https://green-api.com) - plan B: FREE, no Facebook/Meta business.
# Sign up with just an email -> create an instance -> link by scanning a QR
# from your own WhatsApp (Linked devices). Two-way chat, free developer tier.
#   GREENAPI_ID_INSTANCE = numeric instance id from the console
#   GREENAPI_API_TOKEN   = instance api token from the console
#   GREENAPI_API_URL     = per-instance api url, e.g. https://7105.api.greenapi.com
# Webhook to set in their console (Settings -> Webhooks):
#   https://<your-ngrok>/webhook/greenapi   and enable incoming notifications
# ============================================================================
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=https://api.green-api.com
# --- Voice notes (local whisper STT) ---
# model size: tiny | base | small (default, good hi/en) | medium
VOICE_MODEL=small
